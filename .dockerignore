# Docker 빌드 컨텍스트에서 뺄 것들.
# .gitignore와 별개로 동작하므로, 키·가상환경·런타임 산출물을 여기서도 막아야 한다.

# 키 — 이미지에 들어가면 이미지를 받는 누구나 볼 수 있다. 실행 시 환경변수로 넣는다
.env
.env.*
!.env.example

# 가상환경(1.7GB)과 git 이력 — 컨테이너 안에서 requirements.txt로 다시 설치한다
venv/
venv-*/
.venv/
.git/
.github/

# Python·도구 캐시
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# 편집기·OS 파일
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db

# 로컬 DB와 런타임 산출물 — 컨테이너가 실행되며 새로 만든다
backend/app.db
frontend/static/uploads/*
frontend/static/generated/*
!frontend/static/uploads/.gitkeep
!frontend/static/generated/.gitkeep
output/
model2/output/
local_backup/

# 재생성 가능한 캐시 (images/final에서 다시 만든다)
data/

# 앱 실행에 필요 없는 문서·노트북
docs/
model2/notebooks/
PEMFC/
