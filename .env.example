# ==========================================================
# 환경변수 템플릿 — 복사해서 .env 로 사용
#   cp .env.example .env  (그리고 값 채우기)
# ==========================================================

# --- Flask ---
# 세션 서명 키. 비우면 소스에 박힌 개발용 기본값을 써서 세션 위조가 가능하다.
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Gemini (model1 평면도 / model2 무드) ---
# Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (선택) 특징 추출 — 저토큰·저비용 (model2/run_gemini_features.py, 06_gemini_features)
GEMINI_FEATURE_MODEL=gemini-2.5-flash-lite
# 최종 선택 상품 사진 → 상세 SVG 아이콘 속성 추출
GEMINI_PRODUCT_ICON_MODEL=gemini-2.5-flash-lite
# 선택한 무드 이미지 1장만 Gemini로 분석 (상품 후보에는 호출하지 않음)
GEMINI_MOOD_ANALYSIS_ENABLED=1
# 상품 이미지와 선택 무드 이미지의 CLIP 유사도 재정렬
PRODUCT_CLIP_ENABLED=1

# (선택) 분석용 모델 — 인테리어 사진에서 공간 구조 추출 (flash 권장, 정확도↑)
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash

# 평면도 1장 = API 호출 2번(배치 분석 + SVG 생성). 단계별로 모델을 나눌 수 있다.
#  1단계 배치 분석: 결과가 JSON이고 normalize_layout이 빠진 값을 메워줘서
#                   가벼운 모델로 충분. lite 계열은 무료 등급 RPD가 500(vs 20).
#  2단계 SVG 생성 : layout id와 똑같은 <g id="bed_1">를 붙여야 수정 기능이
#                   동작하므로 지시 준수력이 좋은 모델을 쓴다.
# 비우면 위 GEMINI_ANALYSIS_MODEL을 두 단계가 함께 쓴다(기존 동작).
GEMINI_LAYOUT_MODEL=gemini-3.1-flash-lite
GEMINI_SVG_MODEL=gemini-3.6-flash

# (선택) 최종 배치 → gemini-3.6-flash 입체 SVG 렌더
ENABLE_GEMINI_SVG_RENDER=true

# (선택) 공간추론 thinking 예산(토큰). 클수록 정확·느림. 0=끄기, -1=동적
GEMINI_THINKING_BUDGET=4096

# (선택) 자기교정 패스: 1이면 layout을 사진과 재대조해 수정(API 1회 추가). 0=끄기
GEMINI_LAYOUT_REFINE=0

# (선택) Gemini 503/429 일시적 혼잡 시 재시도 설정. 기본 3회 / 첫 대기 1초(이후 2배씩)
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BASE_DELAY=1.0
FLOORPLAN_PROVIDER=model2_gemini_svg

# 평면도 생성 결과 캐시. 1=켜기(기본), 0=끄기.
# 켜도 30분이 지난 결과는 자동으로 버리고 다시 만든다(유효 시간은 코드 고정값,
# model2/web_floorplan.py의 FLOORPLAN_CACHE_TTL_SECONDS).
# 0으로 두면 새로고침마다 Gemini를 다시 호출한다(호출 2번 = RPD 2 소모).
FLOORPLAN_CACHE=1

# --- SerpApi Google Shopping (backend/app.py 가구 추천) ---
# https://serpapi.com/manage-api-key 에서 발급
SERPAPI_API=
SERPAPI_GOOGLE_DOMAIN=google.co.kr
SERPAPI_GL=kr
SERPAPI_HL=ko
SERPAPI_LOCATION=Seoul, South Korea

# (선택) SerpApi 호출 타임아웃(초)과 재시도 횟수. 비우면 30초 / 2회.
# Google Shopping은 캐시 안 된 질의에서 10초를 넘기는 일이 잦다.
SERPAPI_TIMEOUT=30
SERPAPI_RETRIES=2

# (선택) 가구 종류별 검색을 동시에 몇 개까지 보낼지. 비우면 8.
# SerpApi 계정 한도는 시간당 250회라 8 정도는 여유가 있다.
SERPAPI_MAX_WORKERS=8
