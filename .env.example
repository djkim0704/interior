# ==========================================================
# 인테리어 프로젝트 환경변수 예시
# 1) 이 파일을 .env로 복사한다.
# 2) 비어 있는 인증 키를 채운다.
# 3) 값 변경 후 Flask 서버를 재시작한다(.env는 자동으로 다시 읽지 않는다).
# 여기 없는 설정은 코드 기본값을 쓴다.
# ==========================================================

# --- 인증 키 ---
# 모든 Gemini 호출에 쓴다. 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google Shopping 상품 검색. 없으면 상품 추천만 못 쓴다. 발급: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# --- Gemini 모델 ---
# 공용 모델. 아래 전용 모델이 비어 있으면 이 모델을 쓴다.
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite

# 평면도 1단계: 방 사진 → 가구 위치·크기(사진당 1회). 정확도에 가장 큰 영향을 준다.
GEMINI_LAYOUT_MODEL=gemini-3.8-flash
# 분석에 보내는 사진 긴 변(px)과 추론 정도(off|low|medium|high). 호출 수는 그대로다.
GEMINI_LAYOUT_IMAGE_MAX=2400
GEMINI_LAYOUT_THINKING=low

# 평면도 2단계: 가구별 겉모양 SVG(평면도당 1회). 이 SVG가 2D 평면도이자 3D 가구다.
# 3D는 이 SVG를 밀어 올려 세우고, 도형별 높이도 이 호출에서 함께 받는다(3D용 추가 호출 없음).
GEMINI_SVG_MODEL=gemini-3.8-flash

# 평면도 3단계: SVG를 그린 뒤 방 실측과 가구 이름만 글로 주고 크기·높이·배치를 다시 판단하게 한다
# (평면도당 1회, 사진 없이 글만 보내 토큰이 적다. 같은 입력이면 캐시). 0이면 끈다.
# 모델을 비우면 GEMINI_LAYOUT_MODEL을 쓴다. 추론 정도는 minimal|low|medium|high(기본 medium).
GEMINI_SCENE_REFINE=1
GEMINI_SCENE_REFINE_MODEL=
GEMINI_SCENE_REFINE_THINKING=medium

# 상품 사진 → 다리·팔걸이·치수표 같은 형태 속성(상품당 1회, 캐시).
GEMINI_PRODUCT_ATTRIBUTES_MODEL=gemini-3.6-flash
# 무드 이미지 특징 분석, 선택 상품 아이콘.
GEMINI_FEATURE_MODEL=gemini-2.5-flash-lite
GEMINI_PRODUCT_ICON_MODEL=gemini-2.5-flash-lite

# SVG 그림·상품 속성·재분석 요청의 추론 단계(minimal|low|medium|high, 기본 medium).
# 높을수록 판단이 좋아지고 토큰이 늘어난다
GEMINI_THINKING_LEVEL=medium

# --- 기능 켜기·끄기 (1=사용, 0=끄기) ---
# 선택한 무드 이미지 한 장을 Gemini로 추가 분석한다.
GEMINI_MOOD_ANALYSIS_ENABLED=1
# 상품 이미지와 무드의 CLIP 유사도로 추천 순서를 보정한다(로컬 계산, API 호출 없음).
PRODUCT_CLIP_ENABLED=1
# 상품 사진에서 형태 속성을 뽑아 3D·적합도에 반영한다.
PRODUCT_ATTRIBUTES_GEMINI=1
# 상품 제목에 치수가 없으면 상품 페이지를 받아 치수를 찾는다(Gemini 호출 아님).
PRODUCT_PAGE_FETCH=1
# 같은 사진의 평면도 결과를 30분간 재사용한다.
FLOORPLAN_CACHE=1

# --- Gemini 재시도 (429·5xx 응답) ---
GEMINI_RETRY_ATTEMPTS=4
GEMINI_RETRY_BASE_DELAY=5
GEMINI_RETRY_MAX_TOTAL_WAIT=120

# --- SerpApi Google Shopping ---
SERPAPI_GOOGLE_DOMAIN=google.co.kr
SERPAPI_GL=kr
SERPAPI_HL=ko
SERPAPI_LOCATION=Seoul, South Korea
# 같은 검색어 결과 재사용 시간(초). 21600=6시간, 0=캐시 끄기.
SERPAPI_CACHE_TTL_SECONDS=21600
SERPAPI_TIMEOUT=30
SERPAPI_RETRIES=2
SERPAPI_MAX_WORKERS=8
