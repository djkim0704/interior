# ==========================================================
# 인테리어 프로젝트 환경변수 예시
# 1) 이 파일을 .env로 복사한다.
# 2) 비어 있는 인증 키를 채운다.
# 3) 값 변경 후 Flask 서버를 재시작한다.
# ==========================================================

# --- Gemini API 및 모델 ---
# 모든 Gemini 호출에 사용하는 인증 키.
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 무드 이미지 특징 및 가구 추천용 이미지 분석 모델.
GEMINI_FEATURE_MODEL=gemini-2.5-flash-lite

# 선택 상품 사진을 평면도용 상세 SVG 아이콘으로 변환하는 모델.
GEMINI_PRODUCT_ICON_MODEL=gemini-2.5-flash-lite

# 선택한 무드 이미지 한 장을 Gemini로 추가 분석할지 여부. 1=사용, 0=생략.
GEMINI_MOOD_ANALYSIS_ENABLED=1

# 상품 이미지와 선택 무드 이미지의 CLIP 유사도로 추천 순서를 보정할지 여부.
PRODUCT_CLIP_ENABLED=1

# 공용 분석 모델. 전용 모델 변수가 비어 있을 때 대체 모델로도 사용된다.
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite

# model2 평면도 1단계: 방 사진에서 가구 위치·크기·관계를 JSON으로 추출한다.
GEMINI_LAYOUT_MODEL=gemini-3.6-flash

# model2 평면도 2단계: 사진과 배치 JSON을 편집 가능한 2D SVG로 만든다.
GEMINI_SVG_MODEL=gemini-3.5-flash-lite

# 2D 평면도를 누가 그릴지. scene_graph(기본)는 Scene Graph 좌표로 그려 3D와
# 좌표가 같다. gemini는 Gemini가 평면도 전체를 새로 그리는 기존 방식(비교 실험용).
FLOORPLAN_2D_RENDERER=scene_graph

# scene_graph 렌더러에서 가구 겉모양을 누가 그릴지.
# gemini(기본): GEMINI_SVG_MODEL이 가구별 그림만 그리고 위치·크기는 코드가 고정한다.
#   평면도 1장당 1회 호출, 가구를 옮겨도 다시 부르지 않는다(가구 정체성 기준 캐시).
# local: Gemini 없이 코드의 기본 모양으로 그린다.
FLOORPLAN_2D_ARTWORK=gemini

# ----------------------------------------------------------
# 3D 렌더에 쓰는 모델 (유료 키 기준 권장값)
#   three.js는 배치(위치·크기·회전)만 그리고 API를 쓰지 않는다.
#   가구 모양과 위치는 아래 모델들이 만든다. lite 계열이면 모양이 상자처럼
#   단순해지거나 일러스트가 납작하게 나오니 품질이 필요하면 flash 계열을 쓴다.
#
#   GEMINI_FURNITURE_IMAGE_MODEL : 3D 가구 입체 그림(4방향 이미지) — 3D 화면의 기본 표시
#   GEMINI_FURNITURE_PARTS_MODEL : 3D 가구 부품 모형(그림이 없을 때, 모형 보기 전환 시)
#   GEMINI_LAYOUT_MODEL          : 사진 → 가구 위치·크기 (위 "평면도 1단계")
#   GEMINI_PRODUCT_ATTRIBUTES_MODEL : 상품 사진 → 다리·팔걸이·치수표 (3D 형태에 반영)
# ----------------------------------------------------------

# 3D 가구 모양을 만드는 모델. three.js는 배치만 하고, 가구 하나하나의 모양(부품 목록)은
# 이 모델이 가구 사진(상품 사진 또는 방 사진의 해당 부분)을 보고 만든다.
# 가구 정체성 단위로 캐시돼 옮기거나 돌려도 다시 부르지 않는다. 실패한 가구만 기본 모양.
# 품질이 중요하면 유료 flash 계열을 권장한다. 비우면 GEMINI_ANALYSIS_MODEL을 쓴다.
GEMINI_FURNITURE_PARTS_MODEL=gemini-3.6-flash
# 부품 모형 생성. 3D 기본 표시는 아래 AI 입체 그림이라 꺼 둔다(비용 절약).
# 0이면 그림이 없는 가구와 "입체 모형으로 보기"는 코드의 파라메트릭 모양으로 그린다.
GEMINI_OBJECT_PARTS=0
# 부품 모형 품질: 가구당 부품 수, 한 번에 묻는 가구 수(1=가구마다 따로), thinking, 사진 크기
OBJECT_PARTS_MAX=40
OBJECT_PARTS_BATCH=1
GEMINI_OBJECT_PARTS_THINKING=medium
OBJECT_PARTS_IMAGE_MAX=1280

# AI 입체 그림: 이미지 모델이 가구마다 4방향(앞·오른쪽·뒤·왼쪽) 입체 그림을 그리고,
# three.js는 그 그림을 Scene Graph 위치에 세운다. 카메라를 돌리면 가까운 방향 그림으로
# 바뀐다. 그림이 없는 가구는 위의 부품 모형으로 그린다. 3D 화면의 버튼으로 전환할 수 있다.
# 가구당 이미지 생성 4회(최초 1번, 이후 캐시). 1이면 앞 그림 1장만 그린다.
GEMINI_FURNITURE_VIEWS=1
GEMINI_FURNITURE_IMAGE_MODEL=gemini-2.5-flash-image
FURNITURE_VIEW_COUNT=4

# 상품 사진에서 3D 형태 속성(다리·팔걸이·등받이·서랍·치수표)을 뽑을지. 상품당 1회, 캐시
PRODUCT_ATTRIBUTES_GEMINI=1
# 비우면 GEMINI_ANALYSIS_MODEL을 쓴다
GEMINI_PRODUCT_ATTRIBUTES_MODEL=gemini-3.6-flash
# 상품 제목에 치수가 없을 때 상품 페이지를 받아 치수를 찾을지. 0이면 받지 않는다
PRODUCT_PAGE_FETCH=1

# model1 및 topdown 실험에서 래스터 평면도 이미지를 생성하는 모델.
# 현재 model2_gemini_svg의 2D SVG 생성에는 사용하지 않는다.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# model1 배치 분석의 내부 추론 토큰 예산. 0=끄기, -1=동적 할당.
GEMINI_THINKING_BUDGET=4096

# model1에서 배치 JSON을 사진과 한 번 더 비교할지 여부. 1이면 API 호출 1회 추가.
# 현재 model2_gemini_svg 경로에는 적용되지 않는다.
GEMINI_LAYOUT_REFINE=0

# Gemini가 429 또는 일시적인 5xx/503을 반환할 때의 총 시도 횟수.
GEMINI_RETRY_ATTEMPTS=4

# 첫 재시도 전 대기 시간(초). 이후 지수 백오프와 무작위 지연을 적용한다.
GEMINI_RETRY_BASE_DELAY=5

# 한 요청에서 재시도를 위해 기다릴 수 있는 누적 최대 시간(초).
GEMINI_RETRY_MAX_TOTAL_WAIT=120

# 웹 평면도 구현. model2_gemini_svg는 Gemini 상세 SVG를 사용한다.
# 다른 값이면 model1의 규칙 기반 SVG 파이프라인을 사용한다.
FLOORPLAN_PROVIDER=model2_gemini_svg

# 같은 업로드 이미지의 평면도 결과를 30분간 재사용할지 여부. 1=사용, 0=재생성.
FLOORPLAN_CACHE=1

# --- SerpApi Google Shopping (가구 추천) ---
# Google Shopping 검색용 인증 키. 없으면 상품 추천만 사용할 수 없다.
# 발급: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Google Shopping 도메인과 검색 대상 국가·언어·위치.
SERPAPI_GOOGLE_DOMAIN=google.co.kr
SERPAPI_GL=kr
SERPAPI_HL=ko
SERPAPI_LOCATION=Seoul, South Korea

# 동일 검색어의 결과를 저장할 폴더. 비우면 generated/product_cache 아래를 쓴다.
SERPAPI_CACHE_DIR=

# 검색 결과 재사용 시간(초). 21600=6시간, 0=캐시 끄기.
SERPAPI_CACHE_TTL_SECONDS=21600

# SerpApi 요청 한 번의 최대 대기 시간(초).
SERPAPI_TIMEOUT=30

# SerpApi 요청 실패 시 추가 재시도 횟수. 코드에서 최대 2회로 제한한다.
SERPAPI_RETRIES=2

# 여러 가구 종류를 동시에 검색할 최대 작업 수.
SERPAPI_MAX_WORKERS=8
