# Python
__pycache__/
*.py[cod]
.venv/
venv/
venv-linux/
venv-win/
.ipynb_checkpoints/
.vscode/
local_backup/
model2/output/

# OS가 폴더마다 만드는 메타데이터 파일
.DS_Store
Thumbs.db

# 로컬 Python 설치·의존성 산출물
/python-*.exe
/python-install*.log
*.whl
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 환경변수
#   키가 들어 있으므로 추적하지 않는다. clone 후 .env.example 을 복사해 채운다.
.env
backend/app.db

# 생성 산출물 (재생성 가능)
output/floorplans/*
!output/floorplans/.gitkeep

# 임베딩·클러스터·번역 캐시 (약 17MB) — images/final 에서 재생성 가능
#   python -c "from mood_search_v1 import run_embedding, run_clustering, run_labeling"
data/

# 무드 라이브러리는 임베딩·색인(약 3MB)만 커밋한다. 만드는 데 오래 걸리는 부분이라 올려 두면
# clone한 사람은 사진만 images/final에 넣고 바로 쓴다(임베딩을 다시 만들지 않는다).
# 사진 사본(약 200MB)은 images/final과 같은 사진이라 빼고, 없으면 원본에서 찾는다
# (mood_search_v1.config.resolve_library_image).
mood_library/**/*.jpg
mood_library/**/*.JPG
mood_library/**/*.jpeg
mood_library/**/*.png
mood_library/**/*.webp

# 업로드/생성 이미지 (프론트 런타임 산출물)
frontend/static/uploads/*
frontend/static/generated/*
!frontend/static/uploads/.gitkeep
!frontend/static/generated/.gitkeep

# 무드 원본 데이터셋 (52MB, 394장) — 대표 샘플 3장만 커밋
images/final/*
!images/final/003e0ad2bc74.jpg
!images/final/017ccbeb4150.jpg
!images/final/01a3a801d075.JPG

# YOLO 가중치 (최초 실행 시 자동 다운로드)
*.pt

# 평가 산출물 — Gemini 호출 기록·재생용 응답·평가 실행 결과 (재생성 가능)
#   기준값처럼 남겨야 하는 결과는 docs/metrics/ 에 따로 저장한다
output/metrics/
output/gemini_replay/
output/eval/
